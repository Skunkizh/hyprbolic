{
  "cpu": {
    "tooltip": false,
    "interval": 10,
    "format": "󰻠",
    "format-alt": "󰻠 <span size='11pt'>{usage}%</span>",
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  "temperature": {
    "tooltip": false,
    "interval": 10,
    // TODO: this path is specific to Intel "coretemp" hardware monitoring. On other
    // CPUs (e.g. AMD k10temp) it won't exist and the module will show nothing. Find
    // the right one per-machine with `ls /sys/class/hwmon/*/name` (and `cat` each to
    // see which name matches your sensor), then update this path to match.
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "{icon}",
    "format-alt": "{icon} <span size='11pt'>{temperatureC}°C</span>",
    "format-critical": "<span size='12pt'>󱗗 </span><span size='11pt'>{temperatureC}°C</span>",
    "format-icons": [
      "",
      "",
      ""
    ]
  }
}
